# Copy to apps/mobile/.env and restart Metro (npm run mobile -- --clear).
# Supabase dashboard -> Project Settings -> API Keys / Data API.
# Both values are public by design (they ship inside the app). NEVER put the database
# password or a secret key (sb_secret_...) here.

EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
