# Copy this file to .env and fill in real values. .env is git-ignored — never commit it.
# These are SERVER-SIDE secrets: never put them in apps/mobile.

# Supabase -> Project Settings -> Data API (Project URL)
SUPABASE_URL=https://<project-ref>.supabase.co
# Supabase -> Project Settings -> API Keys -> Secret key. Bypasses Row Level Security.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxx

# Supabase -> Project Settings -> Database -> Connection string (URI). Needed from M4.
# Use the "Session pooler" URI if your network has no IPv6.
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

PORT=3000
