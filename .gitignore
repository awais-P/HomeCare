# dependencies
node_modules/

# env / secrets — never commit (Supabase keys, DB passwords live here)
.env
.env.*
!.env.example

# build output
dist/
build/
coverage/
*.tsbuildinfo
.eslintcache

# Expo / React Native
.expo/
web-build/
# Generated by Expo at the app root only (src/types/expo-env.d.ts is ours and is committed)
/apps/mobile/expo-env.d.ts
.metro-health-check*
*.orig.*
apps/mobile/android/
apps/mobile/ios/

# Android / Gradle (when building locally or opening android/ in Android Studio)
.gradle/
.cxx/
local.properties
captures/
*.apk
*.aab
*.hprof

# signing keys & certificates
*.jks
*.keystore
!debug.keystore
*.p8
*.p12
*.key
*.mobileprovision
*.pem

# Supabase CLI local state
supabase/.temp/
supabase/.branches/

# logs
npm-debug.*
yarn-debug.*
yarn-error.*
*.log

# OS / editor
.DS_Store
Thumbs.db
.idea/
*.swp

# Claude Code: personal settings stay local (shared launch.json is committed)
.claude/settings.local.json
